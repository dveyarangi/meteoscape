# Env carries secrets and the store knobs — nothing structured.
# Per-offering settings (a provider's cadence, and the like) are declared in code, on the
# profile's OfferingDef at a composition root; a config file may fill them later (see
# docs/tickets/01-0125-supported-python-embedding.md).

METEOSCAPE_STORE_SPATIAL_STEP=0.0001
METEOSCAPE_RETENTION_INTERVAL=P14D

# Secrets are read only for the offerings a profile declares, at METEOSCAPE_<IMPL>_<SLOT>
# (uppercase; hyphens in the impl id become underscores). A profile declaring a keyed offering
# without its secret refuses startup; any other variable here is inert.
# The shipped server profile is keyless Open-Meteo, so the line below matters only to a profile
# that declares TWC.
METEOSCAPE_TWC_API_KEY=
